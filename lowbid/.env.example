# Copy to .env, fill in, and start with:  uvicorn main:app --env-file .env --port 8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lub_auction
REDIS_URL=redis://localhost:6379/0

# 1 = development (OTP 123456, mock deposits, /api/users). MUST be 0 in production.
DEV_MODE=1

# Required when DEV_MODE=0. Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ADMIN_AUTH_SECRET=

# Game money settings (ETB)
PLATFORM_FEE_FLAT=2.00
PARTNER_COMMISSION_RATE=0.10
BID_MAX_VALUE=100000

# Chapa (leave the key empty until you have it; the mock deposit is used in DEV_MODE)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-public-domain.example
CHAPA_MIN_AMOUNT=10
CHAPA_MAX_AMOUNT=50000

# Admin panel
ADMIN_IP_ALLOWLIST=
ADMIN_TOKEN_HOURS=8
TZ_OFFSET_HOURS=3
ADMIN_MAX_ADJUSTMENT=100000
AUTH_TOKEN_HOURS=72
