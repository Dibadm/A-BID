# --- required in production (DEV_MODE=0) ---
DEV_MODE=0
DATABASE_URL=postgresql://user:pass@host/db?ssl=require
REDIS_URL=rediss://default:pass@host:6379/0
JWT_SECRET=generate-a-random-string-of-at-least-32-characters
ADMIN_JWT_SECRET=a-different-random-string-of-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=another-random-string-of-at-least-32-characters
ALLOWED_ORIGINS=https://your-app.onrender.com
# --- optional ---
ADMIN_ALLOWED_IPS=
TRUST_PROXY=1
UPLOAD_DIR=/var/data/uploads
DB_POOL_SIZE=10
PLATFORM_FEE_FLAT=0.50
PARTNER_COMMISSION_RATE=0.10
